# ===== REQUIRED - Get from Twilio Console =====

# Your Twilio Account SID (starts with AC)
# Find at: console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token
# Find at: console.twilio.com
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp Number (starts with +1 or your country code)
# Find at: Messaging > WhatsApp > Sandbox Settings
TWILIO_WHATSAPP_NUMBER=+1234567890

# ===== OPTIONAL =====

# Where to save downloaded images (default: ./downloads)
# You can use:
#   ./downloads
#   /Users/yourname/Pictures/WhatsApp
#   /home/username/pictures/whatsapp
#   C:\Users\yourname\Downloads\WhatsApp
DOWNLOAD_FOLDER=./downloads

# Port to run bot on (default: 5000)
PORT=5000
